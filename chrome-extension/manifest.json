{
  "manifest_version": 3,
  "name": "YouTube Sentiment Analysis",
  "version": "1.0.0",
  "description": "Analyse des sentiments des commentaires YouTube avec un modèle Machine Learning.",
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://effective-engine-r449rjgpjpwwcxq99-7860.app.github.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyse des sentiments"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
